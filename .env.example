# Copie para .env e preencha. O .env nunca vai para o repositório.

AEGIS_ENVIRONMENT=development

# Obrigatório, mínimo de 32 caracteres. Gere o seu com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_SECRET_KEY=

# SQLite em desenvolvimento; em produção, a URL do PostgreSQL.
AEGIS_DATABASE_URL=sqlite:///./aegis_pt.db
# AEGIS_DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/aegis_pt

AEGIS_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Consulta por IA (L9). Sem chave, /ai/consulta responde 503 e o resto da aplicação sobe
# normalmente. A chave é lida no backend e nunca chega ao navegador.
AEGIS_ANTHROPIC_API_KEY=
# AEGIS_AI_MODELO=claude-opus-5
# AEGIS_AI_ESFORCO=medium

# Modo de bordo: um modelo local servido por Ollama, sem enlace, sem chave e sem PT saindo da
# unidade. Preenchida a URL, a chave acima deixa de ser usada e `AEGIS_AI_MODELO` passa a ser
# o nome do modelo local. Instalar com `ollama pull <modelo>` — precisa suportar ferramentas.
# AEGIS_AI_BASE_URL=http://localhost:11434
# AEGIS_AI_MODELO=gemma4:latest
# Janela de contexto do modelo local. O padrão do Ollama é menor e corta em silêncio.
# AEGIS_AI_LOCAL_CONTEXTO=16384
# Segundos de espera. Modelo em CPU responde em dezenas de segundos.
# AEGIS_AI_LOCAL_TIMEOUT=300
# Camadas na GPU. Vazio deixa o Ollama decidir, que é o certo num servidor com uma placa que
# caiba o modelo. Numa máquina com duas GPUs pequenas a divisão automática derruba o runner
# com GGML_ASSERT — ali é preciso fixar (0 força só CPU).
# AEGIS_AI_LOCAL_NUM_GPU=10
# Raciocínio do modelo local. Ligado é o que faz um modelo pequeno chamar as ferramentas em
# vez de responder com uma pergunta de volta. Desligar só num modelo que dispense.
# AEGIS_AI_LOCAL_PENSAR=true
