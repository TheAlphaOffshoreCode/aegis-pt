# Copie para .env e preencha. O .env nunca vai para o repositório.

AEGIS_ENVIRONMENT=development

# Obrigatório, mínimo de 32 caracteres. Gere o seu com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_SECRET_KEY=

# SQLite em desenvolvimento; em produção, a URL do PostgreSQL.
AEGIS_DATABASE_URL=sqlite:///./aegis_pt.db
# AEGIS_DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/aegis_pt

AEGIS_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Consulta por IA (L9). Sem chave, /ai/consulta responde 503 e o resto da aplicação sobe
# normalmente. A chave é lida no backend e nunca chega ao navegador.
AEGIS_ANTHROPIC_API_KEY=
# AEGIS_AI_MODELO=claude-opus-5
# AEGIS_AI_ESFORCO=medium
